{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Antigravity Portfolio Design Tokens",
  "version": "1.1.0",
  "description": "Design tokens defining the visual identity, typography, spacing, and elevation for Vaibhav Mishra's Product Design portfolio and enterprise case studies.",
  "color": {
    "background": {
      "surface": { "value": "#FFFFFF", "type": "color", "description": "Primary card and container surface" },
      "subtle": { "value": "#F8FAFC", "type": "color", "description": "Subtle input background and section fills" },
      "canvas": { "value": "#F8FAFC", "type": "color", "description": "Page canvas background" },
      "elevated": { "value": "rgba(255, 255, 255, 0.95)", "type": "color", "description": "Glassmorphism card surface" }
    },
    "text": {
      "primary": { "value": "#0F172A", "type": "color", "description": "Headings, titles, and high-contrast text" },
      "secondary": { "value": "#334155", "type": "color", "description": "Narrative copy and primary form labels" },
      "muted": { "value": "#64748B", "type": "color", "description": "Captions, placeholders, and inactive step indicators" }
    },
    "border": {
      "subtle": { "value": "#E2E8F0", "type": "color", "description": "Default card, divider, and field borders" },
      "hover": { "value": "#CBD5E1", "type": "color", "description": "Hover state for interactive borders" },
      "focus": { "value": "#1D64F2", "type": "color", "description": "Active focus ring border" }
    },
    "primary": {
      "blue": {
        "value": "#0047FF",
        "type": "color",
        "description": "Brand primary blue used for titles, key metrics, and primary buttons"
      },
      "blue-accent": {
        "value": "#1D64F2",
        "type": "color",
        "description": "Interactive cobalt blue for form steppers, badges, and focus rings"
      },
      "blue-hover": {
        "value": "#2563EB",
        "type": "color",
        "description": "Hover state for primary interactive elements"
      },
      "blue-light": {
        "value": "#EFF6FF",
        "type": "color",
        "description": "Ultra-light blue for selected rows, active icon backgrounds, and badge surfaces"
      }
    },
    "neutral": {
      "white": { "value": "#FFFFFF", "type": "color" },
      "slate-50": { "value": "#F8FAFC", "type": "color" },
      "slate-100": { "value": "#F1F5F9", "type": "color" },
      "slate-200": { "value": "#E2E8F0", "type": "color" },
      "slate-300": { "value": "#CBD5E1", "type": "color" },
      "slate-400": { "value": "#94A3B8", "type": "color" },
      "slate-500": { "value": "#64748B", "type": "color" },
      "slate-600": { "value": "#475569", "type": "color" },
      "slate-700": { "value": "#334155", "type": "color" },
      "slate-800": { "value": "#1E293B", "type": "color" },
      "slate-900": { "value": "#0F172A", "type": "color" }
    },
    "semantic": {
      "success": {
        "base": { "value": "#10B981", "type": "color" },
        "surface": { "value": "#ECFDF5", "type": "color" },
        "border": { "value": "#A7F3D0", "type": "color" }
      },
      "warning": {
        "base": { "value": "#F59E0B", "type": "color" },
        "surface": { "value": "#FEF3C7", "type": "color" },
        "border": { "value": "#FDE68A", "type": "color" },
        "accent": { "value": "#B45309", "type": "color" }
      },
      "danger": {
        "base": { "value": "#EF4444", "type": "color" },
        "surface": { "value": "#FEF2F2", "type": "color" },
        "border": { "value": "#FECACA", "type": "color" }
      },
      "info": {
        "base": { "value": "#1D64F2", "type": "color" },
        "surface": { "value": "#EFF6FF", "type": "color" },
        "border": { "value": "#BFDBFE", "type": "color" }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "serif": {
        "value": "'DM Serif Display', 'DM Serif Text', Georgia, serif",
        "type": "fontFamily",
        "description": "Editorial headings, case study section titles, hero headlines"
      },
      "sans": {
        "value": "'Poppins', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
        "type": "fontFamily",
        "description": "Portfolio navigation, bio copy, and general narrative text"
      },
      "interface": {
        "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
        "type": "fontFamily",
        "description": "SaaS interface components, forms, steppers, metrics, and data tables"
      },
      "display": {
        "value": "'Sora', sans-serif",
        "type": "fontFamily",
        "description": "Accent headers and impact metrics"
      },
      "mono": {
        "value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
        "type": "fontFamily",
        "description": "Step counters, numerical quantities, and metadata badges"
      }
    },
    "fontSize": {
      "xs": { "value": "0.75rem", "type": "dimension" },
      "sm": { "value": "0.875rem", "type": "dimension" },
      "base": { "value": "1rem", "type": "dimension" },
      "lg": { "value": "1.125rem", "type": "dimension" },
      "xl": { "value": "1.25rem", "type": "dimension" },
      "2xl": { "value": "1.5rem", "type": "dimension" },
      "3xl": { "value": "1.875rem", "type": "dimension" },
      "4xl": { "value": "2.25rem", "type": "dimension" },
      "5xl": { "value": "3rem", "type": "dimension" }
    },
    "fontWeight": {
      "normal": { "value": "400", "type": "fontWeight" },
      "medium": { "value": "500", "type": "fontWeight" },
      "semibold": { "value": "600", "type": "fontWeight" },
      "bold": { "value": "700", "type": "fontWeight" },
      "extrabold": { "value": "800", "type": "fontWeight" }
    }
  },
  "spacing": {
    "space-1": { "value": "0.25rem", "type": "dimension", "description": "4px" },
    "space-2": { "value": "0.5rem", "type": "dimension", "description": "8px" },
    "space-3": { "value": "0.75rem", "type": "dimension", "description": "12px" },
    "space-4": { "value": "1rem", "type": "dimension", "description": "16px" },
    "space-5": { "value": "1.25rem", "type": "dimension", "description": "20px" },
    "space-6": { "value": "1.5rem", "type": "dimension", "description": "24px" },
    "space-8": { "value": "2rem", "type": "dimension", "description": "32px" },
    "space-10": { "value": "2.5rem", "type": "dimension", "description": "40px" },
    "space-12": { "value": "3rem", "type": "dimension", "description": "48px" },
    "space-16": { "value": "4rem", "type": "dimension", "description": "64px" },
    "space-20": { "value": "5rem", "type": "dimension", "description": "80px" },
    "space-24": { "value": "6rem", "type": "dimension", "description": "96px" },
    "space-32": { "value": "8rem", "type": "dimension", "description": "128px" }
  },
  "borderRadius": {
    "sm": { "value": "0.375rem", "type": "dimension" },
    "md": { "value": "0.5rem", "type": "dimension" },
    "lg": { "value": "0.75rem", "type": "dimension" },
    "xl": { "value": "0.875rem", "type": "dimension" },
    "2xl": { "value": "1.25rem", "type": "dimension" },
    "3xl": { "value": "1.5rem", "type": "dimension" },
    "card": { "value": "1.375rem", "type": "dimension", "description": "Standard 22px border radius for modern SaaS form cards" },
    "pill": { "value": "9999px", "type": "dimension", "description": "Full pill shape for CTAs, status badges, and tabs" }
  },
  "elevation": {
    "subtle": {
      "value": "0 1px 2px 0 rgba(0, 0, 0, 0.03)",
      "type": "boxShadow"
    },
    "card": {
      "value": "0 8px 30px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.02)",
      "type": "boxShadow",
      "description": "Default elevation for SaaS form cards and metadata containers"
    },
    "card-hover": {
      "value": "0 16px 40px rgba(29, 100, 242, 0.08), 0 1px 3px rgba(0, 0, 0, 0.02)",
      "type": "boxShadow",
      "description": "Hover elevation with subtle brand tint"
    },
    "float": {
      "value": "0 12px 32px rgba(29, 100, 242, 0.40)",
      "type": "boxShadow",
      "description": "High-prominence floating pill badges"
    },
    "active-ring": {
      "value": "0 0 0 4px rgba(29, 100, 242, 0.15)",
      "type": "boxShadow",
      "description": "Glow ring around active stepper circles and focused input fields"
    }
  },
  "component": {
    "formInput": {
      "height": { "value": "44px", "type": "dimension" },
      "borderRadius": { "value": "12px", "type": "dimension" },
      "border": { "value": "1px solid #E2E8F0", "type": "border" },
      "focusRing": { "value": "0 0 0 4px rgba(29, 100, 242, 0.10)", "type": "boxShadow" }
    },
    "stepper": {
      "circleSize": { "value": "32px", "type": "dimension" },
      "activeColor": { "value": "#1D64F2", "type": "color" },
      "trackWidth": { "value": "2px", "type": "dimension" }
    }
  }
}
